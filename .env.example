# =====================================================================
# Environment variables for RV-Enterprises-Frontend
# Copy this file to `.env` and fill in the real values for local dev.
# NEVER commit the real `.env` file to version control.
# =====================================================================

# Deployed Google Apps Script Web App "/exec" URL.
# See GoogleSheets-Setup.md for how to create & deploy it.
VITE_GAS_WEB_APP_URL=

# ID of the target Google Spreadsheet from its URL:
# https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit...
VITE_SHEET_ID=